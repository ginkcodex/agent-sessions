      "Gemfile.lock": "installed with bundle install --local; PLATFORMS arm64-darwin-25 and ruby; CHECKSUMS section written by default; BUNDLED WITH 4.0.20",
      "drafts": {
        "app.rb v1": "def broken(\n  1 +\n",
        "app.rb v2": "x = \"double\"\nputs(x)  \n",
        "app.rb v3": "# frozen_string_literal: true\n\nputs 'ok'\n"
