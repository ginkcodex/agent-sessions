                  "href": "https://docs.rubocop.org/rubocop/cops_style.html#stylefrozenstringliteralcomment"
                },
                "source": "RuboCop",
                "message": "Style/FrozenStringLiteralComment: Missing frozen string literal comment."
              },
              {
                "range": {
                  "start": {
                    "line": 0,
