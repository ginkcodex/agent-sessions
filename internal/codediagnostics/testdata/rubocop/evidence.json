{
  "tool": "rubocop",
  "provenance": "observed (driven by a Python stdio script, not by the Go adapter)",
  "platform": "darwin/arm64",
  "versions": {
    "rubocop": "1.92.2",
    "ruby": "4.0.9 (mise)",
    "bundler": "4.0.20"
  },
  "location": "gem install --install-dir into a disposable gem directory; Ruby from ~/.local/share/mise/installs/ruby/4.0.9.",
  "sanitization": "Disposable synthetic project in a temp dir replaced with /fixture; code-action data (quick fixes, which the bridge ignores) omitted; message text kept verbatim (no user content).",
  "mode": "standalone",
  "argv": [
    "<ruby prefix>/bin/ruby",
    "<gem dir>/gems/rubocop-1.92.2/exe/rubocop",
    "--lsp"
  ],
  "env": {
    "HOME": "<empty temp dir>",
    "PATH": "<ruby prefix>/bin:/usr/bin:/bin",
    "GEM_HOME": "<gem dir>",
    "GEM_PATH": "<gem dir>:<ruby prefix>/lib/ruby/gems/4.0.0"
  },
  "cwd": "/fixture (the project root; no workspaceFolders sent)",
  "fixture": {
    "drafts": {
      "app.rb v1": "def broken(\n  1 +\n",
      "app.rb v2": "x = \"double\"\nputs(x)  \n",
      "app.rb v3": "# frozen_string_literal: true\n\nputs 'ok'\n"
    }
  },
  "client": {
    "capabilities": {
      "general": {
        "positionEncodings": [
          "utf-16"
        ]
      },
      "textDocument": {
        "publishDiagnostics": {
          "versionSupport": true
        }
      }
    },
    "workspaceFolders": null,
    "serverRequests": "none observed"
  },
  "initialize": {
    "capabilities": {
      "textDocumentSync": {
        "openClose": true,
        "change": 2
      },
      "codeActionProvider": {
        "codeActionKinds": [
          "quickfix"
        ]
      },
      "documentFormattingProvider": true,
      "executeCommandProvider": {
        "commands": [
          "rubocop.formatAutocorrects",
          "rubocop.formatAutocorrectsAll"
        ]
      }
    }
  },
  "shutdown": {
    "result": null,
    "exitCode": 0
  },
  "stderr": [
    "[server] RuboCop 1.92.2 language server initialized, PID 9998",
    "[server] Client asked to shutdown RuboCop language server.",
    "[server] Exiting..."
  ],
  "notes": [
    "No serverInfo and no positionEncoding in the initialize result; UTF-16 is the LSP default.",
    "textDocumentSync change is 2 (incremental); full-text contentChanges without a range are accepted.",
    "Pushes carry no version, although the client declared publishDiagnostics.versionSupport. Each push followed its didOpen/didChange within about 3 ms; the server handles messages in order.",
    "didClose produced no publication; the app removes a closed document's results itself (CloseDocument).",
    "Severities: Lint/Syntax is 1 (error); convention offenses are 3 (information). Codes are cop names; messages start with the cop name, and syntax messages end with a blank line and an autocorrect note.",
    "codeActionProvider, documentFormattingProvider and executeCommandProvider are advertised; the app uses none of them.",
    "No server->client requests. Nothing written to the project or HOME; no rubocop_cache.",
    "Startup (spawn to initialize result) took about 2.3 s, mostly Ruby and gem loading.",
    "Columns are UTF-16 code units (see utf16)."
  ],
  "scenarios": [
    {
      "id": "open-syntax-error",
      "step": "open app.rb v1 (syntax error)",
      "publications": [
        {
          "params": {
            "uri": "file:///fixture/app.rb",
            "diagnostics": [
              {
                "range": {
                  "start": {
                    "line": 1,
                    "character": 2
                  },
                  "end": {
                    "line": 1,
                    "character": 3
                  }
                },
                "severity": 1,
                "code": "Lint/Syntax",
                "codeDescription": {
                  "href": "https://docs.rubocop.org/rubocop/cops_lint.html#lintsyntax"
                },
                "source": "RuboCop",
                "message": "Lint/Syntax: unexpected token tINTEGER\n\nThis offense is not autocorrectable.\n"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "offenses",
      "step": "change app.rb v2 (offenses)",
      "publications": [
        {
          "params": {
            "uri": "file:///fixture/app.rb",
            "diagnostics": [
              {
                "range": {
