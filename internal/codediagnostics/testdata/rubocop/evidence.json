                "codeDescription": {
                  "href": "https://docs.rubocop.org/rubocop/cops_style.html#stylestringliterals"
                },
                "source": "RuboCop",
                "message": "Style/StringLiterals: Prefer single-quoted strings when you don't need string interpolation or special symbols."
              },
              {
                "range": {
                  "start": {
                    "line": 1,
                    "character": 7
                  },
                  "end": {
                    "line": 1,
                    "character": 9
                  }
                },
                "severity": 3,
                "code": "Layout/TrailingWhitespace",
                "codeDescription": {
                  "href": "https://docs.rubocop.org/rubocop/cops_layout.html#layouttrailingwhitespace"
                },
                "source": "RuboCop",
                "message": "Layout/TrailingWhitespace: Trailing whitespace detected."
              }
            ]
          }
        }
      ]
    },
    {
      "id": "fix-clears",
      "step": "change app.rb v3 (clean)",
      "publications": [
        {
          "params": {
            "uri": "file:///fixture/app.rb",
            "diagnostics": []
          }
        }
      ]
    },
    {
      "id": "close",
      "step": "close app.rb",
      "publications": []
    }
  ],
  "bundler": {
    "argv": [
      "<ruby prefix>/bin/ruby",
      "-rbundler/setup",
      "/fixture/vendor/bundle/ruby/4.0.0/gems/rubocop-1.92.2/exe/rubocop",
      "--lsp"
    ],
    "env": {
      "HOME": "<empty temp dir>",
      "PATH": "<ruby prefix>/bin:/usr/bin:/bin",
      "BUNDLE_GEMFILE": "/fixture/Gemfile",
      "BUNDLE_FROZEN": "true"
